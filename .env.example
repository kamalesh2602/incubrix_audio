# IncuBrix Audio Engine - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Environment (development, testing, production)
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Provider Engine Selection
# Options:
#   "mock"       - Deterministic local multi-stem synthesis (zero external API keys, default)
#   "soundverse" - Soundverse Enterprise AI music generation + stem separation
PROVIDER_TYPE=mock

# Local Artifact Storage Directory (for audio stems, mixes, manifests)
# Note: In-memory job state and local artifacts are strictly for development/milestone testing.
STORAGE_DIR=storage

# Audio Synthesis Defaults
DEFAULT_SAMPLE_RATE=44100
DEFAULT_TARGET_LUFS=-14.0
DEFAULT_TEMPO_BPM=120
DEFAULT_KEY=C major

# Duration Validation Limits (in seconds)
MIN_DURATION_S=5.0
MAX_DURATION_S=300.0

# -----------------------------------------------------------------------------
# Soundverse Enterprise API Settings (Phase 2)
# Official Docs: https://platform.soundverse.ai/docs
# -----------------------------------------------------------------------------
# API Key (obtained from https://platform.soundverse.ai/enterprise-platform/apikeys)
# Format: sksoundverse_<your_key>
# CRITICAL: Keep secret; never commit your live API key to version control!
SOUNDVERSE_API_KEY=

# Soundverse Gateway Base URL (keys target https://apiv2.soundverse.ai)
SOUNDVERSE_BASE_URL=https://apiv2.soundverse.ai

# Generation Model Version: "v7", "v6", or "v5"
SOUNDVERSE_MODEL_VERSION=v7

# Stem Separation Variant:
#   "six-stem" - 6-way Demucs split: drums, bass, guitar, piano, other, vocals (default)
#   "12stem"   - 12-stem Demucs split
#   "2stem"    - Demucs karaoke split: vocals + instrumental
SOUNDVERSE_STEM_VARIANT=six-stem

# License Tier:
#   1 = Royalty-Free (default)
#   2 = Standard
#   3 = Distribution
#   4 = Sync
#   5 = Master
SOUNDVERSE_LICENSE_TIER=1

# Polling and retry parameters
SOUNDVERSE_POLL_INTERVAL_S=2.0
SOUNDVERSE_POLL_TIMEOUT_S=180.0
SOUNDVERSE_MAX_RETRIES=3
SOUNDVERSE_RETRY_BACKOFF_S=1.0

# Route flavor: true = use /v{version}/generate/music compat routes; false = native /v1/generations
SOUNDVERSE_USE_COMPAT_ROUTE=true

# -----------------------------------------------------------------------------
# Storage Backend Settings (Local vs S3/MinIO)
# -----------------------------------------------------------------------------
# Options: "local" (default filesystem) or "s3" (AWS S3, MinIO, or LocalStack)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET_NAME=incubrix-audio
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_REGION=us-east-1
# S3_SECURE=false

# Logging Configuration
LOG_LEVEL=INFO
